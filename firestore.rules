rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    // Todos los roles (admin, bartender, cajero) se validan leyendo el
    // documento propio en usuarios/{uid} — nada depende de custom claims ni
    // de que las Cloud Functions estén desplegadas. El admin crea las cuentas
    // de staff con email+contraseña desde el panel y las da de baja poniendo
    // activo=false (o borrando el documento).
    function miDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tieneRolActivo(rol) {
      return estaLogueado() && miDoc().rol == rol && miDoc().activo == true;
    }

    function esAdmin() {
      return tieneRolActivo('admin');
    }

    function esStaff() {
      return tieneRolActivo('bartender') || tieneRolActivo('cajero') || esAdmin();
    }

    // Catálogo: lectura pública, escritura solo admin (vía panel o Cloud Function)
    match /productos/{productoId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Pedidos: el cliente solo lee el suyo (por clienteId == su uid, login anónimo).
    // Staff (bartender/cajero/admin) puede leer/listar para sus paneles.
    // Ninguna escritura directa desde el cliente: todo pasa por Cloud Functions
    // (Admin SDK), que ignoran estas reglas.
    match /pedidos/{pedidoId} {
      allow get: if esStaff() || (estaLogueado() && resource.data.clienteId == request.auth.uid);
      allow list: if esStaff();
      allow create, update, delete: if false;
    }

    // Staff: cada usuario puede leer su propio perfil, admin gestiona todo
    // (alta con email+contraseña, baja/reactivación, eliminación).
    match /usuarios/{usuarioId} {
      allow get: if esAdmin() || (estaLogueado() && request.auth.uid == usuarioId);
      allow list: if esAdmin();
      allow write: if esAdmin();
    }

    // Config general: nunca expuesta al cliente, solo lectura de admin en panel.
    // El mercadoPagoAccessToken vive aparte, solo accesible desde Cloud Functions.
    match /config/{docId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Agregados de ventas: solo el dueño/admin los consulta, los escribe la Cloud Function.
    match /ventasDiarias/{fechaISO} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}
